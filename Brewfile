# Command-line tools the editor setup relies on. Installed by ./install.sh.
brew "neovim"
brew "tmux"
brew "git"
brew "ripgrep"          # project-wide search (Space /)
brew "fd"               # fast file finding (Space Space)
brew "lazygit"          # git UI (Space g g)
brew "tree-sitter-cli"  # compiles syntax-highlighting parsers

# Icons in the explorer, tab bar and status line.
# Remember to select "JetBrainsMono Nerd Font" in your terminal's settings.
cask "font-jetbrains-mono-nerd-font"
